{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "npm run db:push && npm start"
  },
  "variables": {
    "NODE_ENV": {
      "description": "Node environment",
      "value": "production"
    },
    "NEXT_PUBLIC_SITE_URL": {
      "description": "Frontend site URL",
      "value": "https://encogix.com"
    },
    "NEXT_PUBLIC_WHATSAPP": {
      "description": "WhatsApp number",
      "value": "919431607346"
    },
    "NEXT_PUBLIC_CONTACT_EMAIL": {
      "description": "Contact email",
      "value": "contact@encogix.com"
    },
    "ADMIN_USERNAME": {
      "description": "Admin username",
      "value": "admin"
    },
    "ADMIN_PASSWORD": {
      "description": "Admin password (will be generated)",
      "value": "changeme"
    }
  }
}
