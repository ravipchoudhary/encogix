## Example production environment variables.
## Copy this to .env.production and fill real secrets before deploying.

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/encogix?schema=public"

# Admin credentials (created if none exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Server
PORT=3000
NODE_ENV=production

# Next.js public URL (used for canonical tags and absolute links)
NEXT_PUBLIC_SITE_URL=https://encogix.com
NEXT_PUBLIC_WHATSAPP=919431607346
NEXT_PUBLIC_CONTACT_EMAIL=contact@encogix.com

# Optional: Razorpay keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
