# ==========================================
# BACKEND CONFIGURATION
# ==========================================

# Node environment
NODE_ENV=production

# Backend server port
BACKEND_PORT=5000

# PostgreSQL Database (required)
DATABASE_URL="postgresql://user:password@host:5432/encogix"

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_strong_password_in_production

# JWT Secret (change to random string, min 32 chars)
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars

# Razorpay Payment Gateway (optional)
RAZORPAY_KEY_ID=rzp_live_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

# Backend API URL (local development)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Frontend port (local development)
PORT=3000

# Razorpay Public Key (safe to expose in frontend)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_public_key

# Website URL
NEXT_PUBLIC_SITE_URL=https://www.encogix.com

# ==========================================
# NOTES FOR PRODUCTION
# ==========================================
# 1. Backend on Render: Update NEXT_PUBLIC_API_URL to Render backend URL
# 2. Frontend on Vercel: Set env vars in Vercel dashboard, not in .env files
# 3. Never commit .env files with real secrets to git
# 4. Use .gitignore to exclude .env files
# 5. For Render/Vercel, set environment variables in their dashboards


# Contact
NEXT_PUBLIC_WHATSAPP=919431607346
NEXT_PUBLIC_PHONE=919431607346
