# PostgreSQL (required)
DATABASE_URL="postgresql://postgres:password@localhost:5432/encogix?schema=public"

# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_secret

# Default admin (created on first run if no admins exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production

# Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Next.js SSR API base (use your production URL when building)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SITE_URL=https://www.encogix.com

# Contact
NEXT_PUBLIC_WHATSAPP=919431607346
NEXT_PUBLIC_PHONE=919431607346
