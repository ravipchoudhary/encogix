{
  "name": "encogix-technology",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "dev:backend": "node server.js",
    "dev:frontend": "node server.js",
    "build": "cd frontend && npm run build",
    "start": "node server.js",
    "start:frontend": "node server.js",
    "lint": "cd frontend && npm run lint",
    "generate": "npx prisma generate --schema ./prisma/schema.prisma",
    "setup": "npm install && npm run generate && cd backend && npm install && cd ../frontend && npm install",
    "db:migrate": "cd backend && npm run db:migrate",
    "db:push": "cd backend && npm run db:push",
    "db:seed": "cd backend && npm run db:seed",
    "db:studio": "cd backend && npm run db:studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  },
  "postinstall": "npm run generate",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.263.1",
    "multer": "^1.4.5-lts.1",
    "next": "15.5.19",
    "razorpay": "^2.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
