generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       Int     @id @default(autoincrement())
  username String  @unique
  password String
  active   Boolean @default(true)

  @@map("admins")
}

model Contact {
  id                 Int       @id @default(autoincrement())
  name               String?
  email              String?
  phone              String?
  message            String?
  source             String?   @default("contact")
  status             String    @default("new")
  assignedEmployeeId Int?
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id])

  @@map("contacts")
}

model Project {
  id           Int     @id @default(autoincrement())
  title        String?
  description  String?
  image        String?
  category     String?
  client       String?
  technologies String?
  projectUrl   String? @map("project_url")
  slug         String? @unique
  industry     String?
  results      String?

  @@map("projects")
}

model Blog {
  id        Int      @id @default(autoincrement())
  title     String?
  content   String?
  author    String?
  image     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blogs")
}

model Job {
  id          Int     @id @default(autoincrement())
  title       String?
  location    String?
  experience  String?
  description String?

  @@map("jobs")
}

model JobApplication {
  id              Int      @id @default(autoincrement())
  name            String?
  email           String?
  phone           String?
  currentCompany  String?  @map("current_company")
  currentSalary   String?  @map("current_salary")
  expectedSalary  String?  @map("expected_salary")
  experience      String?
  noticePeriod    String?  @map("notice_period")
  resume          String?
  message         String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("job_applications")
}

model InternshipApplication {
  id              Int      @id @default(autoincrement())
  name            String?
  email           String?
  phone           String?
  internshipType  String?  @map("internship_type")
  college         String?
  course          String?
  resume          String?
  message         String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("internship_applications")
}

model ChatbotSetting {
  id   Int    @id
  data String?

  @@map("chatbot_settings")
}

model Employee {
  id           Int              @id @default(autoincrement())
  employeeId   String           @unique @map("employee_id")
  name         String
  username     String?
  email        String?
  phone        String?
  designation  String?
  password     String
  dob          String?
  joinDate     String?          @map("join_date")
  createdAt    DateTime         @default(now()) @map("created_at")
  attendance   Attendance[]
  leaveRequests LeaveRequest[]
  assignedLeads Contact[]
  greetingsSent Greeting[]       @relation("GreetingsFrom")
  greetingsRecv Greeting[]       @relation("GreetingsTo")
  participants  ConversationParticipant[]
  messages      ConversationMessage[]

  @@map("employees")
}

model Attendance {
  id               Int       @id @default(autoincrement())
  employeeId       Int       @map("employee_id")
  date             DateTime  @db.Date
  punchIn          DateTime? @map("punch_in")
  punchOut         DateTime? @map("punch_out")
  punchInLocation  String?   @map("punch_in_location")
  punchOutLocation String?   @map("punch_out_location")
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date], name: "attendance_unique")
  @@map("attendance")
}

model LeaveRequest {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  fromDate   DateTime? @map("from_date") @db.Date
  toDate     DateTime? @map("to_date") @db.Date
  reason     String?
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String?
  content   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("announcements")
}

model Greeting {
  id              Int      @id @default(autoincrement())
  fromEmployeeId  Int      @map("from_employee_id")
  toEmployeeId    Int      @map("to_employee_id")
  occasion        String?
  message         String?
  createdAt       DateTime @default(now()) @map("created_at")
  fromEmployee    Employee @relation("GreetingsFrom", fields: [fromEmployeeId], references: [id], onDelete: Cascade)
  toEmployee      Employee @relation("GreetingsTo", fields: [toEmployeeId], references: [id], onDelete: Cascade)

  @@map("greetings")
}

model Conversation {
  id           Int                       @id @default(autoincrement())
  type         String
  name         String?
  createdAt    DateTime                  @default(now()) @map("created_at")
  participants ConversationParticipant[]
  messages     ConversationMessage[]

  @@map("conversations")
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  employeeId     Int          @map("employee_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([conversationId, employeeId], name: "conversation_participant_unique")
  @@map("conversation_participants")
}

model ConversationMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  fromEmployeeId Int          @map("from_employee_id")
  message        String
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromEmployee   Employee     @relation(fields: [fromEmployeeId], references: [id], onDelete: Cascade)

  @@map("conversation_messages")
}

model Testimonial {
  id          Int     @id @default(autoincrement())
  name        String
  company     String?
  designation String?
  rating      Int     @default(5)
  text        String
  active      Boolean @default(true)
  sortOrder   Int     @default(0) @map("sort_order")

  @@map("testimonials")
}

model Service {
  id          Int     @id @default(autoincrement())
  title       String
  slug        String  @unique
  description String?
  icon        String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0) @map("sort_order")

  @@map("services")
}
